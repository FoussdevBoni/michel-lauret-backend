NODE_ENV=development
HOST=127.0.0.1
PORT=5000
FRONTEND_URL=http://localhost:5173
# Renseigner uniquement dans le fichier local .env, jamais dans cet exemple.
MONGO_URI=
# Secret aléatoire d'au moins 32 caractères pour les sessions cloud.
JWT_SECRET=

MAIL_USER=
MAIL_PASS=
MAIL_RECEIVER=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=cpeg-media-private

# Facultatif : fichier privé persistant de signature des accès hors connexion.
# Créé à la première autorisation si absent ; conserver sur un volume persistant.
OFFLINE_AUTH_KEY_FILE=.local/offline-auth.pem
# Reprise des anciens mots de passe : fichier privé de paramètres SCRYPT.
# Nécessaire jusqu'à conversion ou réinitialisation de tous les comptes importés.
# Aucun accès réseau Firebase n'est utilisé par ce mécanisme.
LEGACY_PASSWORD_HASH_CONFIG_PATH=
# Alternative : OFFLINE_AUTH_PRIVATE_KEY (PEM PKCS8), fourni par le gestionnaire de secrets.
