{
  "name": "cpeg-michel-lauret-backend",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "firebase-admin": "13.5.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "3.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "admin:create": "tsx scripts/createAdmin.ts",
    "test": "tsx --test tests/moduleRoutes.test.ts tests/uploadService.test.ts tests/firestoreExport.test.ts tests/firestoreAudit.test.ts tests/firestoreRestSource.test.ts tests/firestoreIdentityPlan.test.ts tests/legacyPassword.test.ts",
    "test:integration": "tsx --test tests/mongoIntegration.test.ts",
    "test:media:live": "tsx --test tests/mediaLive.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "pnpm typecheck && tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migration:export": "tsx scripts/exportFirestore.ts",
    "test:migration": "tsx --test tests/firestoreExport.test.ts tests/firestoreAudit.test.ts tests/firestoreRestSource.test.ts tests/firestoreIdentityPlan.test.ts",
    "migration:audit": "tsx scripts/auditFirestore.ts",
    "migration:plan-identities": "tsx scripts/planFirestoreIdentities.ts",
    "migration:target-inventory": "tsx scripts/inventoryMigrationTarget.ts",
    "migration:import": "tsx scripts/importFirestore.ts",
    "test:migration:import": "tsx --test tests/firestoreImport.test.ts",
    "migration:auth:export": "tsx scripts/exportFirebaseAccounts.ts",
    "migration:auth:import": "tsx scripts/importTeacherAccounts.ts",
    "test:migration:auth": "tsx --test tests/legacyPassword.test.ts tests/authMigration.test.ts"
  }
}
